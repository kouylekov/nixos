# Font configuration
font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-thicken = true

# Window appearance
window-padding-x = 8
window-padding-y = 8
background-opacity = 0.95
background-blur-radius = 20

# Color scheme (Nord-inspired, on dark background)
background = 141414
foreground = e5e9f0

# Cursor
cursor-color = 88c0d0
cursor-style = block
cursor-style-blink = false

# Nord palette
palette = 0=#3b4252
palette = 1=#bf616a
palette = 2=#a3be8c
palette = 3=#ebcb8b
palette = 4=#81a1c1
palette = 5=#b48ead
palette = 6=#88c0d0
palette = 7=#e5e9f0
palette = 8=#4c566a
palette = 9=#bf616a
palette = 10=#a3be8c
palette = 11=#ebcb8b
palette = 12=#81a1c1
palette = 13=#b48ead
palette = 14=#8fbcbb
palette = 15=#eceff4

# Shell integration
shell-integration = bash
shell-integration-features = cursor,sudo,title

# Mouse behavior
mouse-hide-while-typing = true
copy-on-select = true

# Better text rendering
adjust-cell-height = 10%
adjust-underline-position = 15%
adjust-underline-thickness = 150%

# Window behavior
window-theme = dark
confirm-close-surface = false
quit-after-last-window-closed = true

# Clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false

# Performance
unfocused-split-opacity = 0.8

