{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "florian": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "florian",
      "options": {
        "baseURL": "https://api.tsd.usit.no/v1/p1337/ai/v1",
        "apiKey": "{env:OPENCODE_FLORIAN_API_KEY}"
      },
      "models": {
        "DeepSeek-V4-Flash-0731": {
          "name": "DeepSeek-V4-Flash-0731",
          "tool_call": true,
          "limit": {
            "context": 500000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "high"
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    },
    "lumo-tamer": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lumo (local)",
      "options": {
        "baseURL": "http://localhost:3003/v1",
        "apiKey": "{env:LUMO_API_KEY}"
      },
      "models": {
        "lumo": {
          "name": "Lumo"
        },
        "lumo-lite": {
          "name": "lumo-lite"
        },
        "lumo-max": {
          "name": "lumo-max"
        }
      }
    }
  }
}