#!/usr/bin/env bash
# SSH_ASKPASS helper: answers UiO password/OTP prompts from KeePassXC.
# ssh calls this once per prompt with the prompt text as $1, e.g.
# "(milen-drift@rlogin.uio.no) Password: ".
set -euo pipefail

KPXC="/home/milen/nixos/scripts/kpxc"
# Group in the KeePassXC database holding the UiO accounts.
KPXC_DIR="${UIO_KPXC_DIR:-Work}"

prompt="${1:-}"

# Pick the KeePassXC entry from the user in the prompt: "(user@host) ..." for
# keyboard-interactive, "user@host's password:" for plain password auth.
case "$prompt" in
  *"milen-drift@"*) ENTRY="${UIO_KPXC_ENTRY_DRIFT:-drift}" ;;
  *"milen@"*)       ENTRY="${UIO_KPXC_ENTRY_MILEN:-milen}" ;;
  *) exit 1 ;;
esac

case "$prompt" in
  *[Pp]assword*)
    "$KPXC" show -s -a Password "$KPXC_DIR/$ENTRY"
    ;;
  *[Cc]ode*|*OTP*|*[Oo]ne-time*|*[Vv]erification*|*[Tt]oken*)
    "$KPXC" show -t "$KPXC_DIR/$ENTRY"
    ;;
  *)
    # Unknown prompt (e.g. host key confirmation): refuse rather than guess.
    exit 1
    ;;
esac
